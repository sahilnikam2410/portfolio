node_modules
.next
out
.env*.local
.DS_Store
*.tsbuildinfo

# 3D model sources: keep them local. A hero model is tens or hundreds of
# megabytes, and public/ is served publicly, so anything here would ship.
public/models/*
*.glb
*.fbx
*.obj
*.lwo

# ...but the one character that ships is tracked. Narrow on purpose: the
# blanket ignore above exists to stop a gigabyte of source assets landing in
# the repo, and this reopens it for exactly one file.
!public/models/hero.glb
