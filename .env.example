# Canonical origin for OG tags, robots.txt and sitemap.xml.
# No trailing slash. Read in data/site.js.
#
# Local dev  → leave unset (falls back to http://localhost:3000)
# Vercel     → https://<project>.vercel.app, then your real domain
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so changing this
# requires a redeploy, not just a restart.
NEXT_PUBLIC_SITE_URL=https://sahilnikam.vercel.app
